# Database: local SQLite file by default. For production use a hosted libSQL/Turso URL.
DATABASE_URL=file:./data/pulse.db
# DATABASE_AUTH_TOKEN=

# ── AI coach (pick one) ─────────────────────────────────────────
# FREE: run an open-source model on your own computer with Ollama (https://ollama.com)
#   1) install Ollama   2) ollama pull qwen2.5:7b   3) uncomment the line below
# OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_URL=http://127.0.0.1:11434

# PAID (optional): Claude API key, server-side only
# ANTHROPIC_API_KEY=
# Optional override (defaults to claude-opus-5-5)
# COACH_MODEL=claude-opus-5-5

# FREE exercise videos from Pexels: get a key at https://www.pexels.com/api/ then run `npm run videos`
# PEXELS_API_KEY=

# Optional: base URL of a CDN that hosts licensed exercise videos as <slug>.mp4
# NEXT_PUBLIC_VIDEO_BASE_URL=https://cdn.example.com/exercises
