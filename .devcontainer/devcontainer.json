{
  "name": "Pulse — AI Fitness Coach",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "hostRequirements": { "cpus": 2, "memory": "4gb" },
  "postCreateCommand": "npm install && (test -f .env.local || cp .env.example .env.local)",
  "postAttachCommand": { "website": "npm run dev" },
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": { "label": "Pulse website", "onAutoForward": "openBrowser" }
  },
  "customizations": {
    "codespaces": { "openFiles": ["README.md"] },
    "vscode": { "extensions": ["bradlc.vscode-tailwindcss"] }
  }
}
